# Core (required)
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Auth providers: each is enabled when both of its vars are set
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_APPLE_ID=""
AUTH_APPLE_SECRET=""
AUTH_TWITTER_ID=""
AUTH_TWITTER_SECRET=""

# Email: features/email (Resend)
RESEND_API_KEY=""
EMAIL_FROM="App <hello@example.com>"

# Billing: features/billing (Polar)
POLAR_ACCESS_TOKEN=""
POLAR_WEBHOOK_SECRET=""
POLAR_PRODUCT_ID_PRO=""
POLAR_SERVER="sandbox"

# Analytics: features/analytics (PostHog)
NEXT_PUBLIC_POSTHOG_KEY=""

# Monitoring: features/monitoring (Sentry or GlitchTip)
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_AUTH_TOKEN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
